# Example environment for the CAP demo trio (capd / edge / plantsim).
# The canonical, always-fresh launch is backend/run.sh — values below mirror it.
# Each binary reads only its own variables; everything has sane defaults.

# ── capd — API/dashboard/WebSocket server (backend/cmd/capd)
ENVIRONMENT=development
HTTP_ADDR=127.0.0.1:8000
DB_URL=sqlite://../.run/cap.db
GATEWAY_TOKEN=cap-demo-token
CONTROL_ENABLED=1
PLANTSIM_URL=http://127.0.0.1:15080
STALENESS_SECONDS=60s

# ── edge — Modbus polling collector (backend/cmd/edge)
GATEWAY_ID=gw-plant-01
GATEWAY_TOKEN=cap-demo-token
SERVER_URL=http://127.0.0.1:8000
GATEWAY_BUFFER_DB=../.run/gateway-buffer.db
SOURCE_DRIVER=modbus
MODBUS_ADDR=127.0.0.1:1502
MODBUS_UNIT_ID=1
POLL_INTERVAL=1s
PUSH_INTERVAL=1s
PULSE_INTERVAL=5s
CONTROL_ENABLED=1
CONTROL_POLL=1s
# TAGS: full register map lives in backend/run.sh

# ── plantsim — flotation stand simulator (backend/cmd/plantsim)
PLANTSIM_MODBUS_ADDR=127.0.0.1:1502
PLANTSIM_HTTP_ADDR=127.0.0.1:15080
