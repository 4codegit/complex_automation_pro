[Unit]
Description=AutoPro Monitoring Server
Documentation=https://github.com/autopro/autopro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autopro
Group=autopro
WorkingDirectory=/opt/autopro
Environment=DB_URL=sqlite:///var/lib/autopro/autopro.db
Environment=HTTP_ADDR=0.0.0.0:8000
Environment=SIMULATOR_ENABLED=true
Environment=STALENESS_SECONDS=60s
ExecStart=/opt/autopro/bin/autopro-server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autopro-server
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target