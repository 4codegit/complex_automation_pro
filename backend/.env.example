# Environment
ENVIRONMENT=development

# HTTP listener
HTTP_ADDR=127.0.0.1:8000

# Storage: pure-Go SQLite by default (single binary, no external services).
# Production: use PostgreSQL with the same code, e.g.
# DB_URL=postgres://capuser:cappass@localhost:5432/capdb
DB_URL=sqlite://./cap.db

# Development simulator (must be false in production)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=1s
EMERGENCY_DURATION=15s

# A sample older than this is reported as "stale" by /telemetry/latest
STALENESS_SECONDS=60s

# Ingestion / pull API bounds
INGEST_MAX_BATCH=500
DEFAULT_LIMIT=100
MAX_LIMIT=1000

# --- Edge gateway (store-and-forward) -------------------------------------
# GATEWAY_ID=gw-crushing-01
# SERVER_URL=http://127.0.0.1:8000
# GATEWAY_BUFFER_DB=./gateway-buffer.db     # local SQLite/WAL queue
# POLL_INTERVAL=1s                          # instrument read cadence
# PUSH_INTERVAL=1s                          # delivery attempt cadence
# PULSE_INTERVAL=5s                         # heartbeat to /ingest/gateway_events
# MAX_BATCH=100                             # batch size for :batch ingest
# TAGS=plant-a.crushing.particle_size:mm,plant-a.crushing.pulp_density:g/cm3
#
# Instrument drivers: SOURCE_DRIVER=simulated (default) | opcua | modbus
#
# Modbus TCP (read-only, FC 1-4). Tag spec suffix: |reg=<fc>:<addr>:<type>[:<scale>]
#   fc = hr|ir|c|di; type = bool|u16|i16|u32|i32|f32 (+ "sw" word swap)
# MODBUS_ADDR=10.0.0.50:502
# MODBUS_UNIT_ID=1
# MODBUS_TIMEOUT=1s
# TAGS=plant-a.grinding.mill_power:kW|reg=hr:100:f32,plant-a.flotation.ph_level:pH|reg=ir:30:u16:0.01
#
# MQTT Sparkplug B (read-only host-application role, subscribes spBv1.0/#).
# Tag spec suffix: |sp=group/edge/metric  or  |sp=group/edge/device/metric
# MQTT_BROKER=tcp://10.0.0.60:1883
# MQTT_CLIENT_ID=cap-gw-crushing-01        # stable id required (CleanSession=false)
# MQTT_USERNAME=...
# MQTT_PASSWORD=...
# TAGS=plant-a.grinding.mill_power:kW|sp=plant-a/grinding-01/mill_power

# --- Supervisory control (ADR-003, OFF by default) --------------------------
# CONTROL_ENABLED=true включает PID-контур и канал записи на привод.
# CONTROL_LOOP=pv=plant-a.flotation.ph_level,out=plant-a.flotation.doser_speed,kp=2,ki=0.4,kd=0,deadband=0.1,slew=5
# CONTROL_STALE=15s                            # сторож свежести PV
# На шлюзе: CONTROL_OUT_TAG=plant-a.flotation.doser_speed
#           CONTROL_WRITE=hr:10:u16  CONTROL_POLL=1s
