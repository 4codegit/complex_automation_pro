# Environment
ENVIRONMENT=development

# HTTP listener
HTTP_ADDR=127.0.0.1:8000

# Storage: pure-Go SQLite by default (single binary, no external services).
# Production: use PostgreSQL with the same code, e.g.
# DB_URL=postgres://autoprouser:autopropass@localhost:5432/autoprodb
DB_URL=sqlite://./autopro.db

# Development simulator (must be false in production)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=1s
EMERGENCY_DURATION=15s

# A sample older than this is reported as "stale" by /telemetry/latest
STALENESS_SECONDS=60s

# Ingestion / pull API bounds
INGEST_MAX_BATCH=500
DEFAULT_LIMIT=100
MAX_LIMIT=1000

# --- Edge gateway (store-and-forward) -------------------------------------
# GATEWAY_ID=gw-crushing-01
# SERVER_URL=http://127.0.0.1:8000
# GATEWAY_BUFFER_DB=./gateway-buffer.db     # local SQLite/WAL queue
# POLL_INTERVAL=1s                          # instrument read cadence
# PUSH_INTERVAL=1s                          # delivery attempt cadence
# PULSE_INTERVAL=5s                         # heartbeat to /ingest/gateway_events
# MAX_BATCH=100                             # batch size for :batch ingest
# TAGS=plant-a.crushing.particle_size:mm,plant-a.crushing.pulp_density:g/cm3
